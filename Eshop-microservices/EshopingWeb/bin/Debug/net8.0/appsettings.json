{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "File": {
            "Path": "Logs/app-log-.txt",
            "RollingInterval": "Day"
        }
    },
    "AllowedHosts": "*"
}
